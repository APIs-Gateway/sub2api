  打开 = ["_self"] {"host":"v1","path":"/import","params":{"resource":"provider","app":"claude","name":"Hiyo - Claude","homepage":"https://codex.hiyo.top","endpoint":"https://codex.hiyo.top/antigravity","apiKey":"sk-SECRET-1234567890abcdef","configFormat":"json","usageEnabled":"true","usageScript":"<692 字符 sha1:650401abcd2d 开头:\\"KHsKICAgIHJlcXVlc3Q6IHsKICAgICAgdXJsOiAie3tiYXNlVXJsfX0iLnJl\\">","usageAutoInterval":"30"}}
  改名并选模型后 = {"host":"v1","path":"/import","params":{"resource":"provider","app":"claude","model":"claude-opus-5","name":"Mine","homepage":"https://codex.hiyo.top","endpoint":"https://codex.hiyo.top/antigravity","apiKey":"sk-SECRET-1234567890abcdef","configFormat":"json","usageEnabled":"true","usageScript":"<692 字符 sha1:650401abcd2d 开头:\\"KHsKICAgIHJlcXVlc3Q6IHsKICAgICAgdXJsOiAie3tiYXNlVXJsfX0iLnJl\\">","usageAutoInterval":"30"}}
ccs-client-gemini: placeholder = Hiyo - Gemini
  复制链接 = {"host":"v1","path":"/import","params":{"resource":"provider","app":"gemini","name":"Hiyo - Gemini","homepage":"https://codex.hiyo.top","endpoint":"https://codex.hiyo.top/antigravity","apiKey":"sk-SECRET-1234567890abcdef","configFormat":"json","usageEnabled":"true","usageScript":"<692 字符 sha1:650401abcd2d 开头:\\"KHsKICAgIHJlcXVlc3Q6IHsKICAgICAgdXJsOiAie3tiYXNlVXJsfX0iLnJl\\">","usageAutoInterval":"30"}}
  打开 = ["_self"] {"host":"v1","path":"/import","params":{"resource":"provider","app":"gemini","name":"Hiyo - Gemini","homepage":"https://codex.hiyo.top","endpoint":"https://codex.hiyo.top/antigravity","apiKey":"sk-SECRET-1234567890abcdef","configFormat":"json","usageEnabled":"true","usageScript":"<692 字符 sha1:650401abcd2d 开头:\\"KHsKICAgIHJlcXVlc3Q6IHsKICAgICAgdXJsOiAie3tiYXNlVXJsfX0iLnJl\\">","usageAutoInterval":"30"}}
  改名并选模型后 = {"host":"v1","path":"/import","params":{"resource":"provider","app":"gemini","model":"claude-opus-5","name":"Mine","homepage":"https://codex.hiyo.top","endpoint":"https://codex.hiyo.top/antigravity","apiKey":"sk-SECRET-1234567890abcdef","configFormat":"json","usageEnabled":"true","usageScript":"<692 字符 sha1:650401abcd2d 开头:\\"KHsKICAgIHJlcXVlc3Q6IHsKICAgICAgdXJsOiAie3tiYXNlVXJsfX0iLnJl\\">","usageAutoInterval":"30"}}"
