  打开 = ["https://chatgpt.com/?hints=search q=\\"请按这份文档，帮我把正在用的工具接入 Hiyo：http://localhost:3000/llms.txt\\" [\\"_blank\\",\\"noopener,noreferrer\\"]","https://claude.ai/new q=\\"请按这份文档，帮我把正在用的工具接入 Hiyo：http://localhost:3000/llms.txt\\" [\\"_blank\\",\\"noopener,noreferrer\\"]"]
第一个客户端的详细版全文:
请帮我把 Claude Code 接入 Hiyo（兼容 OpenAI 和 Anthropic 格式的 API 服务）。
请先阅读：http://localhost:3000/docs/claude-code.md
按文档里的步骤一步步带我配置。

接入信息：
- Anthropic 兼容 Base URL（不带 /v1）：https://codex.hiyo.top
- OpenAI 兼容 Base URL（Cursor、聊天客户端等用）：https://codex.hiyo.top/v1
- 密钥：用 sk-你的密钥 占位，我会自己填，不要让我把真实密钥发给你。
- 这个密钥可以调用的模型：claude-sonnet-5、claude-opus-5
- 完整、最新的模型列表：用这个密钥请求 GET https://codex.hiyo.top/v1/models 查看，不要凭记忆填写模型名。
- 密钥变量用 ANTHROPIC_AUTH_TOKEN，不是 ANTHROPIC_API_KEY；电脑上残留的 ANTHROPIC_API_KEY 要删掉。
- 如果返回 400，提示字段不被接受，在 env 里加 CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1，重启后再试。

要求：
1. 要改的文件路径或设置项写清楚。
2. 需要我的系统、工具等信息时直接问我。
3. 最后告诉我怎么验证是否成功；出错时对照 http://localhost:3000/docs/errors.md 排查。
4. 如果你本身就是运行在我电脑上的编程助手，可以直接帮我修改配置文件，但动手前先告诉我要改哪些内容。"
`;

exports[`KeyOnboardingModal 页签快照 > 'anthropic 中文界面' > ccswitch 页签 1`] = `
"### DOM
<div aria-labelledby="onboarding-N-tab-ccswitch" class="onb-card space-y-4" data-test="panel-ccswitch" id="onboarding-N-panel-ccswitch" role="tabpanel">
 <header class="space-y-1">
  <h4 class="font-serif text-lg text-gray-900 dark:text-white" data-test="ccs-title">
   "一键导入 CC Switch"
  <p class="text-sm text-gray-600 dark:text-dark-400" data-test="ccs-intro">
   "选好客户端和模型后，点「打开 CC Switch」即可导入。"
 <div class="grid gap-4 sm:grid-cols-2">
  <!--v-if-->
  <div class="sm:col-span-2">
   <label class="input-label" for="ccs-name">
    "配置名称"
   <input class="input" data-test="ccs-name" id="ccs-name" placeholder="Hiyo - Claude" type="text" :value="">
 <div>
  <div class="grid gap-4 sm:grid-cols-2" data-test="ccs-models">
   <div class="">
    <label class="input-label" for="onboarding-N-ccs-model">
     "主模型"
    <select class="input" data-test="ccs-model" id="onboarding-N-ccs-model" value="claude-sonnet-5" :value="claude-sonnet-5">
     <option value="">
      "可选；留空时使用 CC Switch 默认模型"
     <option value="claude-opus-5">
      "claude-opus-5"
     <option value="claude-sonnet-5">
      "claude-sonnet-5"
   <div class="">
    <label class="input-label" for="onboarding-N-ccs-haikuModel">
     "Haiku 模型"
    <select class="input" data-test="ccs-model-haiku" id="onboarding-N-ccs-haikuModel" value="" :value="">
     <option value="">
      "可选；留空时使用 CC Switch 默认模型"
     <option value="claude-opus-5">
      "claude-opus-5"
     <option value="claude-sonnet-5">
      "claude-sonnet-5"
   <div class="">
    <label class="input-label" for="onboarding-N-ccs-sonnetModel">
     "Sonnet 模型"
    <select class="input" data-test="ccs-model-sonnet" id="onboarding-N-ccs-sonnetModel" value="claude-sonnet-5" :value="claude-sonnet-5">
     <option value="">
      "可选；留空时使用 CC Switch 默认模型"
     <option value="claude-opus-5">
      "claude-opus-5"
     <option value="claude-sonnet-5">
      "claude-sonnet-5"
   <div class="">
    <label class="input-label" for="onboarding-N-ccs-opusModel">
     "Opus 模型"
    <select class="input" data-test="ccs-model-opus" id="onboarding-N-ccs-opusModel" value="claude-opus-5" :value="claude-opus-5">
     <option value="">
      "可选；留空时使用 CC Switch 默认模型"
     <option value="claude-opus-5">
      "claude-opus-5"
     <option value="claude-sonnet-5">
      "claude-sonnet-5"
  <!--v-if-->
 <p class="text-sm text-gray-600 dark:text-dark-400" data-test="ccs-switch-note">
  "确认导入后会立即切换到这个配置，之后可以在 CC Switch 里随时切换。"
 <div class="flex flex-wrap items-center gap-2">
  <button class="btn btn-primary" data-test="ccs-open" type="button">
   "打开 CC Switch"
  <button class="btn btn-secondary" data-test="ccs-copy-link" type="button">
   "复制导入链接"
 <div class="space-y-1.5">
  <p class="text-sm text-gray-600 dark:text-dark-400">
   "点了没反应？请先安装 CC Switch，再点一次。"
   <a class="font-medium text-primary-700 underline-offset-2 hover:underline dark:text-primary-400" href="https://github.com/farion1231/cc-switch/releases" rel="noopener noreferrer" target="_blank">
    "下载 CC Switch"
  <p class="text-xs text-gray-500 dark:text-dark-400" data-test="ccs-balance-note">
   "余额查询已随配置导入，并每 5 分钟自动刷新。"

### 复制与链接
(单一客户端): placeholder = Hiyo - Claude
  ccs-model = "claude-sonnet-5" 选项 = ["可选；留空时使用 CC Switch 默认模型","claude-opus-5","claude-sonnet-5"]
  ccs-model-haiku = "" 选项 = ["可选；留空时使用 CC Switch 默认模型","claude-opus-5","claude-sonnet-5"]
  ccs-model-sonnet = "claude-sonnet-5" 选项 = ["可选；留空时使用 CC Switch 默认模型","claude-opus-5","claude-sonnet-5"]
  ccs-model-opus = "claude-opus-5" 选项 = ["可选；留空时使用 CC Switch 默认模型","claude-opus-5","claude-sonnet-5"]
  模型提示 = null
  按钮禁用 = [false,false]
  复制链接 = {"host":"v1","path":"/import","params":{"resource":"provider","app":"claude","model":"claude-sonnet-5","sonnetModel":"claude-sonnet-5","opusModel":"claude-opus-5","name":"Hiyo - Claude","homepage":"https://codex.hiyo.top","endpoint":"https://codex.hiyo.top","apiKey":"sk-SECRET-1234567890abcdef","configFormat":"json","enabled":"true","usageEnabled":"true","usageScript":"<688 字符 sha1:4d1d18499c78 开头:\\"KHsKICAgIHJlcXVlc3Q6IHsKICAgICAgdXJsOiAie3tiYXNlVXJsfX0iLnJl\\">","usageAutoInterval":"5"}}
  打开 = ["_self"] {"host":"v1","path":"/import","params":{"resource":"provider","app":"claude","model":"claude-sonnet-5","sonnetModel":"claude-sonnet-5","opusModel":"claude-opus-5","name":"Hiyo - Claude","homepage":"https://codex.hiyo.top","endpoint":"https://codex.hiyo.top","apiKey":"sk-SECRET-1234567890abcdef","configFormat":"json","enabled":"true","usageEnabled":"true","usageScript":"<688 字符 sha1:4d1d18499c78 开头:\\"KHsKICAgIHJlcXVlc3Q6IHsKICAgICAgdXJsOiAie3tiYXNlVXJsfX0iLnJl\\">","usageAutoInterval":"5"}}
  改名并换主模型后 = {"host":"v1","path":"/import","params":{"resource":"provider","app":"claude","model":"claude-opus-5","sonnetModel":"claude-sonnet-5","opusModel":"claude-opus-5","name":"Mine","homepage":"https://codex.hiyo.top","endpoint":"https://codex.hiyo.top","apiKey":"sk-SECRET-1234567890abcdef","configFormat":"json","enabled":"true","usageEnabled":"true","usageScript":"<688 字符 sha1:4d1d18499c78 开头:\\"KHsKICAgIHJlcXVlc3Q6IHsKICAgICAgdXJsOiAie3tiYXNlVXJsfX0iLnJl\\">","usageAutoInterval":"5"}}"
