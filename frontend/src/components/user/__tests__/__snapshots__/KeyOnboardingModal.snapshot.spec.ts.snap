exports[`KeyOnboardingModal 页签快照 > 'anthropic 中文界面' > manual 页签 1`] = `
"### DOM
<div aria-labelledby="onboarding-N-tab-manual" class="onb-card space-y-5" data-test="panel-manual" id="onboarding-N-panel-manual" role="tabpanel">
 <div class="grid gap-3" data-test="manual-lines">
  <div class="line-card" data-test="manual-line-0">
   <div class="flex items-center gap-2">
    <span class="line-name">
     "默认"
    <!--v-if-->
   <div class="space-y-1">
    <p class="text-xs text-gray-500 dark:text-dark-400">
     "OpenAI 兼容地址"
    <div class="flex items-center gap-2">
     <code class="min-w-0 flex-1 break-all font-mono text-sm text-gray-900 dark:text-gray-100">
      "https://codex.hiyo.top/v1"
