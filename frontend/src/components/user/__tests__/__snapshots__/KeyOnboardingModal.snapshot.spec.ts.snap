     <div class="overflow-hidden rounded-lg border border-gray-200 bg-white dark:border-dark-700 dark:bg-dark-800">
      <div class="flex items-center justify-between gap-3 border-b border-gray-100 px-3 py-1.5 dark:border-dark-700">
       <span class="font-mono min-w-0 truncate text-xs text-gray-500 dark:text-dark-400">
        "~/.claude/settings.json"
       <button class="inline-flex shrink-0 items-center rounded-md border border-gray-200 bg-white px-2 py-0.5 text-xs text-gray-600 transition-colors duration-150 hover:bg-gray-100 hover:text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 dark:border-dark-700 dark:bg-dark-800 dark:text-gray-400 dark:hover:bg-dark-700 dark:hover:text-white" type="button">
        <span class="text-xs">
         "复制"
      <pre class="overflow-x-auto bg-gray-900 px-4 py-3 text-[13px] leading-relaxed text-gray-100 dark:bg-dark-950">
       "{\\n  \\"env\\": {\\n    \\"ANTHROPIC_BASE_URL\\": \\"https://codex.hiyo.top\\",\\n    \\"ANTHROPIC_AUTH_TOKEN\\": \\"sk-SECRET-1234567890abcdef\\"\\n  }\\n}"
   <details class="rounded-lg border border-gray-200 bg-white px-4 py-2.5 dark:border-dark-700 dark:bg-dark-800">
    <summary class="cursor-pointer select-none text-sm font-medium text-gray-900 dark:text-white">
     "OpenCode"
    <div class="mt-3 space-y-2">
     <div class="overflow-hidden rounded-lg border border-gray-200 bg-white dark:border-dark-700 dark:bg-dark-800">
      <div class="flex items-center justify-between gap-3 border-b border-gray-100 px-3 py-1.5 dark:border-dark-700">
       <span class="font-mono min-w-0 truncate text-xs text-gray-500 dark:text-dark-400">
        "~/.config/opencode/opencode.json"
       <button class="inline-flex shrink-0 items-center rounded-md border border-gray-200 bg-white px-2 py-0.5 text-xs text-gray-600 transition-colors duration-150 hover:bg-gray-100 hover:text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 dark:border-dark-700 dark:bg-dark-800 dark:text-gray-400 dark:hover:bg-dark-700 dark:hover:text-white" type="button">
        <span class="text-xs">
         "复制"
      <pre class="overflow-x-auto bg-gray-900 px-4 py-3 text-[13px] leading-relaxed text-gray-100 dark:bg-dark-950">
       "{\\n  \\"$schema\\": \\"https://opencode.ai/config.json\\",\\n  \\"provider\\": {\\n    \\"anthropic\\": {\\n      \\"options\\": {\\n        \\"baseURL\\": \\"https://codex.hiyo.top/v1\\",\\n        \\"apiKey\\": \\"sk-SECRET-1234567890abcdef\\"\\n      }\\n    }\\n  }\\n}"
 <div>
  <p class="mb-2 font-serif text-sm text-gray-900 dark:text-white">
   "连不上时检查"
  <ul class="list-disc space-y-1.5 pl-5 text-sm text-gray-600 marker:text-gray-300 dark:text-dark-400 dark:marker:text-dark-600">
   <li>
    "地址不要多带斜杠；OpenAI 兼容的客户端要用以 /v1 结尾的地址。"
   <li>
    "密钥要完整复制，前后不能有空格或换行。"
   <li>
    "改完配置后重启客户端。"
   <li>
    "确认网络或代理可以访问接入地址；客户端版本太旧时先升级。"
 <a class="inline-flex text-sm font-medium text-primary-700 hover:underline dark:text-primary-400" href="https://docs.example.com" rel="noopener noreferrer" target="_blank">
  "查看文档"
 <p class="border-t border-gray-200 pt-3 text-xs text-gray-500 dark:border-dark-700 dark:text-dark-400" data-test="manual-footer">
  "请妥善保管密钥，任何拿到它的人都能消耗你的余额或套餐。"

### 复制与链接
按钮 copy-line-0-v1 -> "https://codex.hiyo.top/v1"
按钮 copy-line-0-base -> "https://codex.hiyo.top"
按钮 copy-key -> "sk-SECRET-1234567890abcdef"
按钮 Claude Code -> "export ANTHROPIC_BASE_URL='https://codex.hiyo.top'\\nexport ANTHROPIC_AUTH_TOKEN='sk-SECRET-1234567890abcdef'"
按钮 Claude Code -> "{\\n  \\"env\\": {\\n    \\"ANTHROPIC_BASE_URL\\": \\"https://codex.hiyo.top\\",\\n    \\"ANTHROPIC_AUTH_TOKEN\\": \\"sk-SECRET-1234567890abcdef\\"\\n  }\\n}"
按钮 OpenCode -> "{\\n  \\"$schema\\": \\"https://opencode.ai/config.json\\",\\n  \\"provider\\": {\\n    \\"anthropic\\": {\\n      \\"options\\": {\\n        \\"baseURL\\": \\"https://codex.hiyo.top/v1\\",\\n        \\"apiKey\\": \\"sk-SECRET-1234567890abcdef\\"\\n      }\\n    }\\n  }\\n}"
代码页签 = ["openai","curl","claude"]
## manual-tab-openai
按钮 manual-code-openai-python -> "# pip install openai\\nfrom openai import OpenAI\\n\\nclient = OpenAI(\\n    base_url=\\"https://codex.hiyo.top/v1\\",\\n    api_key=\\"sk-SECRET-1234567890abcdef\\",\\n)\\n\\nresp = client.chat.completions.create(\\n    model=\\"claude-sonnet-5\\",\\n    messages=[{\\"role\\": \\"user\\", \\"content\\": \\"Hello\\"}],\\n)\\nprint(resp.choices[0].message.content)"
## manual-tab-curl
按钮 manual-code-curl-bash -> "curl https://codex.hiyo.top/v1/chat/completions \\\\\\n  -H 'Authorization: Bearer sk-SECRET-1234567890abcdef' \\\\\\n  -H 'Content-Type: application/json' \\\\\\n  -d '{\\"model\\":\\"claude-sonnet-5\\",\\"messages\\":[{\\"role\\":\\"user\\",\\"content\\":\\"Hello\\"}]}'"
按钮 manual-code-curl-windows -> "@'\\n{\\"model\\":\\"claude-sonnet-5\\",\\"messages\\":[{\\"role\\":\\"user\\",\\"content\\":\\"Hello\\"}]}\\n'@ | curl.exe https://codex.hiyo.top/v1/chat/completions -H 'Authorization: Bearer sk-SECRET-1234567890abcdef' -H 'Content-Type: application/json' -d '@-'"
## manual-tab-claude
按钮 manual-code-claude-bash -> "export ANTHROPIC_BASE_URL='https://codex.hiyo.top'\\nexport ANTHROPIC_AUTH_TOKEN='sk-SECRET-1234567890abcdef'\\nclaude -p 'Hello'"
按钮 manual-code-claude-windows -> "$env:ANTHROPIC_BASE_URL = 'https://codex.hiyo.top'\\n$env:ANTHROPIC_AUTH_TOKEN = 'sk-SECRET-1234567890abcdef'\\nclaude -p 'Hello'""
`;

