    <button aria-controls="onboarding-N-panel-manual" aria-selected="true" class="onb-tab onb-tab-active" data-test="tab-manual" id="onboarding-N-tab-manual" role="tab" tabindex="0" type="button">
     <svg aria-hidden="true" class="h-4 w-4" fill="none" stroke-width="1.5" stroke="currentColor" viewBox="0 0 24 24">
