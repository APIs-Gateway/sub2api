exports[`KeyOnboardingModal 页签快照 > 'anthropic 中文界面' > ai 页签 1`] = `
"### DOM
<div aria-labelledby="onboarding-N-tab-ai" class="onb-card space-y-4" data-test="panel-ai" id="onboarding-N-panel-ai" role="tabpanel">
 <p class="text-sm text-gray-600 dark:text-dark-400">
  "选好要用的软件，把下面这句话发给 AI 助手，它会带着你配置。"
 <div aria-label="客户端" class="flex flex-wrap gap-2" role="radiogroup">
  <button aria-checked="true" class="onb-chip onb-chip-active" data-test="ai-client-claude" role="radio" type="button">
   "Claude Code"
  <button aria-checked="false" class="onb-chip" data-test="ai-client-cursor" role="radio" type="button">
   "Cursor"
  <button aria-checked="false" class="onb-chip" data-test="ai-client-chat" role="radio" type="button">
   "聊天客户端"
  <button aria-checked="false" class="onb-chip" data-test="ai-client-code" role="radio" type="button">
   "写代码调用"
  <button aria-checked="false" class="onb-chip" data-test="ai-client-other" role="radio" type="button">
   "其他"
 <textarea class="input w-full resize-none text-sm leading-relaxed" data-test="ai-prompt" readonly="" rows="5" value="请带我把「Claude Code」接入 Hiyo。接入地址是 https://codex.hiyo.top，接口格式是 Anthropic。需要设置环境变量 ANTHROPIC_BASE_URL（填接入地址）和 ANTHROPIC_AUTH_TOKEN（填密钥），也可以写进 ~/.claude/settings.json 的 env 里。密钥我会自己填，请不要向我索要。 参考文档：https://docs.example.com" :value="请带我把「Claude Code」接入 Hiyo。接入地址是 https://codex.hiyo.top，接口格式是 Anthropic。需要设置环境变量 ANTHROPIC_BASE_URL（填接入地址）和 ANTHROPIC_AUTH_TOKEN（填密钥），也可以写进 ~/.claude/settings.json 的 env 里。密钥我会自己填，请不要向我索要。 参考文档：https://docs.example.com">
 <div class="flex flex-wrap gap-2">
  <button class="btn btn-primary btn-sm" data-test="ai-copy" type="button">
   "复制"
  <button class="btn btn-secondary btn-sm" data-test="ai-copy-detail" type="button">
   "复制详细版"
  <button class="btn btn-secondary btn-sm" data-test="ai-open-chatgpt" type="button">
   "在 ChatGPT 中打开"
  <button class="btn btn-secondary btn-sm" data-test="ai-open-claude" type="button">
   "在 Claude 中打开"
 <p class="text-xs text-gray-500 dark:text-dark-400">
  "这句话里没有你的密钥，配置时请自己填写。"

