"### DOM
<div aria-labelledby="onboarding-N-tab-install" class="space-y-4" data-test="panel-install" id="onboarding-N-panel-install" role="tabpanel">
 <section class="onb-card" data-test="client-claude">
  <header class="flex items-center justify-between gap-3">
   <h4 class="font-serif text-lg text-gray-900 dark:text-white">
