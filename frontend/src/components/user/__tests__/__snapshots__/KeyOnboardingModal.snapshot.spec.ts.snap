    "curl"
   <button aria-checked="false" class="onb-chip" data-test="manual-tab-codex" role="radio" type="button">
    "Codex"
  <p class="text-xs text-gray-500 dark:text-dark-400" data-test="manual-key-state">
   "Your key is filled in below"
  <div class="space-y-2">
   <div class="overflow-hidden rounded-lg border border-gray-200 bg-white dark:border-dark-700 dark:bg-dark-800" data-test="manual-code-openai-python">
    <div class="flex items-center justify-between gap-3 border-b border-gray-100 px-3 py-1.5 dark:border-dark-700">
     <span class="min-w-0 truncate text-xs text-gray-500 dark:text-dark-400">
      "Python"
     <button class="inline-flex shrink-0 items-center rounded-md border border-gray-200 bg-white px-2 py-0.5 text-xs text-gray-600 transition-colors duration-150 hover:bg-gray-100 hover:text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 dark:border-dark-700 dark:bg-dark-800 dark:text-gray-400 dark:hover:bg-dark-700 dark:hover:text-white" type="button">
      <span class="text-xs">
       "Copy"
    <pre class="overflow-x-auto bg-gray-900 px-4 py-3 text-[13px] leading-relaxed text-gray-100 dark:bg-dark-950">
     "# pip install openai\\nfrom openai import OpenAI\\n\\nclient = OpenAI(\\n    base_url=\\"https://codex.hiyo.top/v1\\",\\n    api_key=\\"sk-SECRET-1234567890abcdef\\",\\n)\\n\\nresp = client.chat.completions.create(\\n    model=\\"gpt-5.6-sol\\",\\n    messages=[{\\"role\\": \\"user\\", \\"content\\": \\"Hello\\"}],\\n)\\nprint(resp.choices[0].message.content)"
 <div>
  <p class="mb-2 font-serif text-sm text-gray-900 dark:text-white">
   "Save it in a config file"
  <div class="space-y-2">
   <details class="rounded-lg border border-gray-200 bg-white px-4 py-2.5 dark:border-dark-700 dark:bg-dark-800">
    <summary class="cursor-pointer select-none text-sm font-medium text-gray-900 dark:text-white">
     "Codex CLI"
    <div class="mt-3 space-y-2">
     <div class="overflow-hidden rounded-lg border border-gray-200 bg-white dark:border-dark-700 dark:bg-dark-800">
      <div class="flex items-center justify-between gap-3 border-b border-gray-100 px-3 py-1.5 dark:border-dark-700">
       <span class="font-mono min-w-0 truncate text-xs text-gray-500 dark:text-dark-400">
        "~/.codex/config.toml"
       <button class="inline-flex shrink-0 items-center rounded-md border border-gray-200 bg-white px-2 py-0.5 text-xs text-gray-600 transition-colors duration-150 hover:bg-gray-100 hover:text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 dark:border-dark-700 dark:bg-dark-800 dark:text-gray-400 dark:hover:bg-dark-700 dark:hover:text-white" type="button">
        <span class="text-xs">
         "Copy"
      <pre class="overflow-x-auto bg-gray-900 px-4 py-3 text-[13px] leading-relaxed text-gray-100 dark:bg-dark-950">
       "model_provider = \\"hiyo\\"\\nmodel = \\"gpt-5.6-sol\\"\\n\\n[model_providers.hiyo]\\nname = \\"Hiyo\\"\\nbase_url = \\"https://codex.hiyo.top/v1\\"\\nwire_api = \\"responses\\"\\nrequires_openai_auth = false\\nexperimental_bearer_token = \\"sk-SECRET-1234567890abcdef\\""
   <details class="rounded-lg border border-gray-200 bg-white px-4 py-2.5 dark:border-dark-700 dark:bg-dark-800">
    <summary class="cursor-pointer select-none text-sm font-medium text-gray-900 dark:text-white">
     "OpenCode"
    <div class="mt-3 space-y-2">
     <div class="overflow-hidden rounded-lg border border-gray-200 bg-white dark:border-dark-700 dark:bg-dark-800">
      <div class="flex items-center justify-between gap-3 border-b border-gray-100 px-3 py-1.5 dark:border-dark-700">
       <span class="font-mono min-w-0 truncate text-xs text-gray-500 dark:text-dark-400">
        "~/.config/opencode/opencode.json"
       <button class="inline-flex shrink-0 items-center rounded-md border border-gray-200 bg-white px-2 py-0.5 text-xs text-gray-600 transition-colors duration-150 hover:bg-gray-100 hover:text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 dark:border-dark-700 dark:bg-dark-800 dark:text-gray-400 dark:hover:bg-dark-700 dark:hover:text-white" type="button">
        <span class="text-xs">
         "Copy"
      <pre class="overflow-x-auto bg-gray-900 px-4 py-3 text-[13px] leading-relaxed text-gray-100 dark:bg-dark-950">
       "{\\n  \\"$schema\\": \\"https://opencode.ai/config.json\\",\\n  \\"provider\\": {\\n    \\"openai\\": {\\n      \\"options\\": {\\n        \\"baseURL\\": \\"https://codex.hiyo.top/v1\\",\\n        \\"apiKey\\": \\"sk-SECRET-1234567890abcdef\\"\\n      }\\n    }\\n  }\\n}"
 <div>
  <p class="mb-2 font-serif text-sm text-gray-900 dark:text-white">
   "If it will not connect"
  <ul class="list-disc space-y-1.5 pl-5 text-sm text-gray-600 marker:text-gray-300 dark:text-dark-400 dark:marker:text-dark-600">
   <li>
    "Do not add extra slashes to the address. OpenAI-compatible clients need an address ending in /v1."
   <li>
    "Copy the whole key, with no spaces or line breaks around it."
   <li>
    "Restart the client after changing its config."
   <li>
    "Check that your network or proxy can reach the endpoint, and update the client if it is old."
 <a class="inline-flex text-sm font-medium text-primary-700 hover:underline dark:text-primary-400" href="https://docs.example.com" rel="noopener noreferrer" target="_blank">
  "View docs"
 <p class="border-t border-gray-200 pt-3 text-xs text-gray-500 dark:border-dark-700 dark:text-dark-400" data-test="manual-footer">
  "Keep your key safe. Anyone who has it can spend your balance or plan."

### 复制与链接
按钮 copy-line-0-v1 -> "https://codex.hiyo.top/v1"
按钮 copy-key -> "sk-SECRET-1234567890abcdef"
按钮 Codex CLI -> "model_provider = \\"hiyo\\"\\nmodel = \\"gpt-5.6-sol\\"\\n\\n[model_providers.hiyo]\\nname = \\"Hiyo\\"\\nbase_url = \\"https://codex.hiyo.top/v1\\"\\nwire_api = \\"responses\\"\\nrequires_openai_auth = false\\nexperimental_bearer_token = \\"sk-SECRET-1234567890abcdef\\""
按钮 OpenCode -> "{\\n  \\"$schema\\": \\"https://opencode.ai/config.json\\",\\n  \\"provider\\": {\\n    \\"openai\\": {\\n      \\"options\\": {\\n        \\"baseURL\\": \\"https://codex.hiyo.top/v1\\",\\n        \\"apiKey\\": \\"sk-SECRET-1234567890abcdef\\"\\n      }\\n    }\\n  }\\n}"
代码页签 = ["openai","curl","codex"]
## manual-tab-openai
按钮 manual-code-openai-python -> "# pip install openai\\nfrom openai import OpenAI\\n\\nclient = OpenAI(\\n    base_url=\\"https://codex.hiyo.top/v1\\",\\n    api_key=\\"sk-SECRET-1234567890abcdef\\",\\n)\\n\\nresp = client.chat.completions.create(\\n    model=\\"gpt-5.6-sol\\",\\n    messages=[{\\"role\\": \\"user\\", \\"content\\": \\"Hello\\"}],\\n)\\nprint(resp.choices[0].message.content)"
## manual-tab-curl
按钮 manual-code-curl-bash -> "curl https://codex.hiyo.top/v1/chat/completions \\\\\\n  -H 'Authorization: Bearer sk-SECRET-1234567890abcdef' \\\\\\n  -H 'Content-Type: application/json' \\\\\\n  -d '{\\"model\\":\\"gpt-5.6-sol\\",\\"messages\\":[{\\"role\\":\\"user\\",\\"content\\":\\"Hello\\"}]}'"
按钮 manual-code-curl-windows -> "@'\\n{\\"model\\":\\"gpt-5.6-sol\\",\\"messages\\":[{\\"role\\":\\"user\\",\\"content\\":\\"Hello\\"}]}\\n'@ | curl.exe https://codex.hiyo.top/v1/chat/completions -H 'Authorization: Bearer sk-SECRET-1234567890abcdef' -H 'Content-Type: application/json' -d '@-'"
## manual-tab-codex
按钮 manual-code-codex-bash -> "export OPENAI_API_KEY='sk-SECRET-1234567890abcdef'\\ncodex exec --skip-git-repo-check -m gpt-5.6-sol \\\\\\n  -c model_provider=hiyo \\\\\\n  -c model_providers.hiyo.name=Hiyo \\\\\\n  -c model_providers.hiyo.base_url=https://codex.hiyo.top/v1 \\\\\\n  -c model_providers.hiyo.env_key=OPENAI_API_KEY \\\\\\n  -c model_providers.hiyo.wire_api=responses \\\\\\n  'Hello'"
按钮 manual-code-codex-windows -> "$env:OPENAI_API_KEY = 'sk-SECRET-1234567890abcdef'\\ncodex exec --skip-git-repo-check -m gpt-5.6-sol -c model_provider=hiyo -c model_providers.hiyo.name=Hiyo -c model_providers.hiyo.base_url=https://codex.hiyo.top/v1 -c model_providers.hiyo.env_key=OPENAI_API_KEY -c model_providers.hiyo.wire_api=responses 'Hello'""
`;

