### 复制与链接
按钮 copy-line-0-v1 -> "https://codex.hiyo.top/v1"
按钮 copy-key -> "sk-SECRET-1234567890abcdef"
按钮 Codex CLI -> "model_provider = \\"hiyo\\"\\nmodel = \\"gpt-5.6-sol\\"\\n\\n[model_providers.hiyo]\\nname = \\"Hiyo\\"\\nbase_url = \\"https://codex.hiyo.top/v1\\"\\nwire_api = \\"responses\\"\\nrequires_openai_auth = false\\nexperimental_bearer_token = \\"sk-SECRET-1234567890abcdef\\""
按钮 OpenCode -> "{\\n  \\"$schema\\": \\"https://opencode.ai/config.json\\",\\n  \\"provider\\": {\\n    \\"openai\\": {\\n      \\"options\\": {\\n        \\"baseURL\\": \\"https://codex.hiyo.top/v1\\",\\n        \\"apiKey\\": \\"sk-SECRET-1234567890abcdef\\"\\n      }\\n    }\\n  }\\n}"
代码页签 = ["openai","curl","codex"]
## manual-tab-openai
按钮 manual-code-openai-python -> "# pip install openai\\nfrom openai import OpenAI\\n\\nclient = OpenAI(\\n    base_url=\\"https://codex.hiyo.top/v1\\",\\n    api_key=\\"sk-SECRET-1234567890abcdef\\",\\n)\\n\\nresp = client.chat.completions.create(\\n    model=\\"gpt-5.6-sol\\",\\n    messages=[{\\"role\\": \\"user\\", \\"content\\": \\"Hello\\"}],\\n)\\nprint(resp.choices[0].message.content)"
## manual-tab-curl
按钮 manual-code-curl-bash -> "curl https://codex.hiyo.top/v1/chat/completions \\\\\\n  -H 'Authorization: Bearer sk-SECRET-1234567890abcdef' \\\\\\n  -H 'Content-Type: application/json' \\\\\\n  -d '{\\"model\\":\\"gpt-5.6-sol\\",\\"messages\\":[{\\"role\\":\\"user\\",\\"content\\":\\"Hello\\"}]}'"
按钮 manual-code-curl-windows -> "@'\\n{\\"model\\":\\"gpt-5.6-sol\\",\\"messages\\":[{\\"role\\":\\"user\\",\\"content\\":\\"Hello\\"}]}\\n'@ | curl.exe https://codex.hiyo.top/v1/chat/completions -H 'Authorization: Bearer sk-SECRET-1234567890abcdef' -H 'Content-Type: application/json' -d '@-'"
## manual-tab-codex
按钮 manual-code-codex-bash -> "export OPENAI_API_KEY='sk-SECRET-1234567890abcdef'\\ncodex exec --skip-git-repo-check -m gpt-5.6-sol \\\\\\n  -c model_provider=hiyo \\\\\\n  -c model_providers.hiyo.name=Hiyo \\\\\\n  -c model_providers.hiyo.base_url=https://codex.hiyo.top/v1 \\\\\\n  -c model_providers.hiyo.env_key=OPENAI_API_KEY \\\\\\n  -c model_providers.hiyo.wire_api=responses \\\\\\n  'Hello'"
按钮 manual-code-codex-windows -> "$env:OPENAI_API_KEY = 'sk-SECRET-1234567890abcdef'\\ncodex exec --skip-git-repo-check -m gpt-5.6-sol -c model_provider=hiyo -c model_providers.hiyo.name=Hiyo -c model_providers.hiyo.base_url=https://codex.hiyo.top/v1 -c model_providers.hiyo.env_key=OPENAI_API_KEY -c model_providers.hiyo.wire_api=responses 'Hello'""
`;

exports[`KeyOnboardingModal 页签快照 > '未知平台' > ai 页签 1`] = `
"### DOM
<div aria-labelledby="onboarding-N-tab-ai" class="onb-card space-y-4" data-test="panel-ai" id="onboarding-N-panel-ai" role="tabpanel">
 <p class="text-sm text-gray-600 dark:text-dark-400">
  "Pick the app you want to use and send this message to an AI assistant. It will walk you through the setup."
 <div aria-label="Client" class="flex flex-wrap gap-2" role="radiogroup">
  <button aria-checked="true" class="onb-chip onb-chip-active" data-test="ai-client-chat" role="radio" type="button">
   "Chat app"
  <button aria-checked="false" class="onb-chip" data-test="ai-client-code" role="radio" type="button">
   "Calling from code"
  <button aria-checked="false" class="onb-chip" data-test="ai-client-other" role="radio" type="button">
   "Other"
 <textarea class="input w-full resize-none text-sm leading-relaxed" data-test="ai-prompt" readonly="" rows="5" value="Please help me connect "Chat app" to Hiyo. The endpoint is https://codex.hiyo.top and the API format is Anthropic. It needs a custom provider added in the app's settings, using the Anthropic-compatible type, with the endpoint and key filled in and the model names added by hand. I will enter the key myself, so please do not ask me to send it to you. Docs: https://docs.example.com" :value="Please help me connect \\"Chat app\\" to Hiyo. The endpoint is https://codex.hiyo.top and the API format is Anthropic. It needs a custom provider added in the app's settings, using the Anthropic-compatible type, with the endpoint and key filled in and the model names added by hand. I will enter the key myself, so please do not ask me to send it to you. Docs: https://docs.example.com">
 <div class="flex flex-wrap gap-2">
  <button class="btn btn-primary btn-sm" data-test="ai-copy" type="button">
   "Copy"
  <button class="btn btn-secondary btn-sm" data-test="ai-copy-detail" type="button">
   "Copy detailed version"
  <button class="btn btn-secondary btn-sm" data-test="ai-open-chatgpt" type="button">
   "Open in ChatGPT"
  <button class="btn btn-secondary btn-sm" data-test="ai-open-claude" type="button">
   "Open in Claude"
