 <div>
  <div class="grid gap-4 sm:grid-cols-2" data-test="ccs-models">
   <div class="">
    <label class="input-label" for="onboarding-N-ccs-model">
     "Primary model"
    <select class="input" data-test="ccs-model" id="onboarding-N-ccs-model" value="claude-opus-5" :value="claude-opus-5">
     <option value="">
      "Optional; leave blank to use the CC Switch default"
     <option value="claude-opus-5">
      "claude-opus-5"
