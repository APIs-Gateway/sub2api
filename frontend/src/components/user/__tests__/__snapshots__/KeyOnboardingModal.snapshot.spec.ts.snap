"### DOM
<div aria-labelledby="onboarding-N-tab-manual" class="onb-card space-y-5" data-test="panel-manual" id="onboarding-N-panel-manual" role="tabpanel">
 <div class="grid gap-3" data-test="manual-lines">
  <div class="line-card" data-test="manual-line-0">
   <div class="flex items-center gap-2">
    <span class="line-name">
     "Default"
    <!--v-if-->
   <div class="space-y-1">
    <p class="text-xs text-gray-500 dark:text-dark-400">
     "OpenAI-compatible endpoint"
    <div class="flex items-center gap-2">
     <code class="min-w-0 flex-1 break-all font-mono text-sm text-gray-900 dark:text-gray-100">
      "https://codex.hiyo.top/v1"
     <button class="inline-flex shrink-0 items-center rounded-md border border-gray-200 bg-white px-2 py-0.5 text-xs text-gray-600 transition-colors duration-150 hover:bg-gray-100 hover:text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 dark:border-dark-700 dark:bg-dark-800 dark:text-gray-400 dark:hover:bg-dark-700 dark:hover:text-white" data-test="copy-line-0-v1" type="button">
      "Copy"
   <div class="space-y-1">
    <p class="text-xs text-gray-500 dark:text-dark-400">
     "Endpoint"
    <div class="flex items-center gap-2">
     <code class="min-w-0 flex-1 break-all font-mono text-sm text-gray-900 dark:text-gray-100">
      "https://codex.hiyo.top"
     <button class="inline-flex shrink-0 items-center rounded-md border border-gray-200 bg-white px-2 py-0.5 text-xs text-gray-600 transition-colors duration-150 hover:bg-gray-100 hover:text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 dark:border-dark-700 dark:bg-dark-800 dark:text-gray-400 dark:hover:bg-dark-700 dark:hover:text-white" data-test="copy-line-0-base" type="button">
      "Copy"
   <p class="text-xs text-gray-500 dark:text-dark-400" data-test="manual-line-note" id="manual-5-line-note-0">
    "Enter this address in your client."
 <div class="line-row" data-test="manual-key">
  <span class="shrink-0 text-sm text-gray-600 dark:text-dark-400">
   "API Key"
  <code class="min-w-0 flex-1 truncate font-mono text-sm tabular-nums text-gray-900 dark:text-gray-100">
   "sk-SEC…cdef"
  <button class="inline-flex shrink-0 items-center rounded-md border border-gray-200 bg-white px-2 py-0.5 text-xs text-gray-600 transition-colors duration-150 hover:bg-gray-100 hover:text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 dark:border-dark-700 dark:bg-dark-800 dark:text-gray-400 dark:hover:bg-dark-700 dark:hover:text-white" data-test="copy-key" type="button">
   "Copy"
 <section class="space-y-3" data-test="manual-code">
  <div aria-label="Code examples" class="flex flex-wrap gap-2" role="radiogroup">
   <button aria-checked="false" class="onb-chip" data-test="manual-tab-openai" role="radio" type="button">
    "OpenAI SDK"
   <button aria-checked="false" class="onb-chip" data-test="manual-tab-curl" role="radio" type="button">
    "curl"
   <button aria-checked="true" class="onb-chip onb-chip-active" data-test="manual-tab-gemini" role="radio" type="button">
    "Gemini"
  <p class="text-xs text-gray-500 dark:text-dark-400" data-test="manual-key-state">
   "Your key is filled in below"
  <div class="space-y-2">
   <div class="overflow-hidden rounded-lg border border-gray-200 bg-white dark:border-dark-700 dark:bg-dark-800" data-test="manual-code-gemini-bash">
    <div class="flex items-center justify-between gap-3 border-b border-gray-100 px-3 py-1.5 dark:border-dark-700">
     <span class="min-w-0 truncate text-xs text-gray-500 dark:text-dark-400">
      "macOS / Linux"
     <button class="inline-flex shrink-0 items-center rounded-md border border-gray-200 bg-white px-2 py-0.5 text-xs text-gray-600 transition-colors duration-150 hover:bg-gray-100 hover:text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 dark:border-dark-700 dark:bg-dark-800 dark:text-gray-400 dark:hover:bg-dark-700 dark:hover:text-white" type="button">
      <span class="text-xs">
       "Copy"
    <pre class="overflow-x-auto bg-gray-900 px-4 py-3 text-[13px] leading-relaxed text-gray-100 dark:bg-dark-950">
     "export GOOGLE_GEMINI_BASE_URL='https://codex.hiyo.top'\\nexport GEMINI_API_KEY='sk-SECRET-1234567890abcdef'\\ngemini -m gemini-3-pro -p 'Hello'"
   <div class="overflow-hidden rounded-lg border border-gray-200 bg-white dark:border-dark-700 dark:bg-dark-800" data-test="manual-code-gemini-windows">
    <div class="flex items-center justify-between gap-3 border-b border-gray-100 px-3 py-1.5 dark:border-dark-700">
     <span class="min-w-0 truncate text-xs text-gray-500 dark:text-dark-400">
      "Windows PowerShell"
     <button class="inline-flex shrink-0 items-center rounded-md border border-gray-200 bg-white px-2 py-0.5 text-xs text-gray-600 transition-colors duration-150 hover:bg-gray-100 hover:text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 dark:border-dark-700 dark:bg-dark-800 dark:text-gray-400 dark:hover:bg-dark-700 dark:hover:text-white" type="button">
      <span class="text-xs">
       "Copy"
    <pre class="overflow-x-auto bg-gray-900 px-4 py-3 text-[13px] leading-relaxed text-gray-100 dark:bg-dark-950">
     "$env:GOOGLE_GEMINI_BASE_URL = 'https://codex.hiyo.top'\\n$env:GEMINI_API_KEY = 'sk-SECRET-1234567890abcdef'\\ngemini -m gemini-3-pro -p 'Hello'"
 <div>
  <p class="mb-2 font-serif text-sm text-gray-900 dark:text-white">
   "Save it in a config file"
  <div class="space-y-2">
   <details class="rounded-lg border border-gray-200 bg-white px-4 py-2.5 dark:border-dark-700 dark:bg-dark-800">
    <summary class="cursor-pointer select-none text-sm font-medium text-gray-900 dark:text-white">
     "Gemini CLI"
    <div class="mt-3 space-y-2">
     <div class="overflow-hidden rounded-lg border border-gray-200 bg-white dark:border-dark-700 dark:bg-dark-800">
      <div class="flex items-center justify-between gap-3 border-b border-gray-100 px-3 py-1.5 dark:border-dark-700">
       <span class="min-w-0 truncate text-xs text-gray-500 dark:text-dark-400">
        "Environment variables"
       <button class="inline-flex shrink-0 items-center rounded-md border border-gray-200 bg-white px-2 py-0.5 text-xs text-gray-600 transition-colors duration-150 hover:bg-gray-100 hover:text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 dark:border-dark-700 dark:bg-dark-800 dark:text-gray-400 dark:hover:bg-dark-700 dark:hover:text-white" type="button">
        <span class="text-xs">
         "Copy"
      <pre class="overflow-x-auto bg-gray-900 px-4 py-3 text-[13px] leading-relaxed text-gray-100 dark:bg-dark-950">
       "export GOOGLE_GEMINI_BASE_URL='https://codex.hiyo.top'\\nexport GEMINI_API_KEY='sk-SECRET-1234567890abcdef'"
     <div class="overflow-hidden rounded-lg border border-gray-200 bg-white dark:border-dark-700 dark:bg-dark-800">
      <div class="flex items-center justify-between gap-3 border-b border-gray-100 px-3 py-1.5 dark:border-dark-700">
       <span class="font-mono min-w-0 truncate text-xs text-gray-500 dark:text-dark-400">
        "~/.gemini/.env"
       <button class="inline-flex shrink-0 items-center rounded-md border border-gray-200 bg-white px-2 py-0.5 text-xs text-gray-600 transition-colors duration-150 hover:bg-gray-100 hover:text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 dark:border-dark-700 dark:bg-dark-800 dark:text-gray-400 dark:hover:bg-dark-700 dark:hover:text-white" type="button">
        <span class="text-xs">
         "Copy"
      <pre class="overflow-x-auto bg-gray-900 px-4 py-3 text-[13px] leading-relaxed text-gray-100 dark:bg-dark-950">
       "GOOGLE_GEMINI_BASE_URL='https://codex.hiyo.top'\\nGEMINI_API_KEY='sk-SECRET-1234567890abcdef'"
   <details class="rounded-lg border border-gray-200 bg-white px-4 py-2.5 dark:border-dark-700 dark:bg-dark-800">
    <summary class="cursor-pointer select-none text-sm font-medium text-gray-900 dark:text-white">
     "OpenCode"
    <div class="mt-3 space-y-2">
     <div class="overflow-hidden rounded-lg border border-gray-200 bg-white dark:border-dark-700 dark:bg-dark-800">
      <div class="flex items-center justify-between gap-3 border-b border-gray-100 px-3 py-1.5 dark:border-dark-700">
       <span class="font-mono min-w-0 truncate text-xs text-gray-500 dark:text-dark-400">
        "~/.config/opencode/opencode.json"
       <button class="inline-flex shrink-0 items-center rounded-md border border-gray-200 bg-white px-2 py-0.5 text-xs text-gray-600 transition-colors duration-150 hover:bg-gray-100 hover:text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 dark:border-dark-700 dark:bg-dark-800 dark:text-gray-400 dark:hover:bg-dark-700 dark:hover:text-white" type="button">
        <span class="text-xs">
         "Copy"
      <pre class="overflow-x-auto bg-gray-900 px-4 py-3 text-[13px] leading-relaxed text-gray-100 dark:bg-dark-950">
       "{\\n  \\"$schema\\": \\"https://opencode.ai/config.json\\",\\n  \\"provider\\": {\\n    \\"google\\": {\\n      \\"options\\": {\\n        \\"baseURL\\": \\"https://codex.hiyo.top/v1beta\\",\\n        \\"apiKey\\": \\"sk-SECRET-1234567890abcdef\\"\\n      }\\n    }\\n  }\\n}"
 <div>
  <p class="mb-2 font-serif text-sm text-gray-900 dark:text-white">
   "If it will not connect"
  <ul class="list-disc space-y-1.5 pl-5 text-sm text-gray-600 marker:text-gray-300 dark:text-dark-400 dark:marker:text-dark-600">
   <li>
    "Do not add extra slashes to the address. OpenAI-compatible clients need an address ending in /v1."
   <li>
    "Copy the whole key, with no spaces or line breaks around it."
   <li>
    "Restart the client after changing its config."
   <li>
    "Check that your network or proxy can reach the endpoint, and update the client if it is old."
 <a class="inline-flex text-sm font-medium text-primary-700 hover:underline dark:text-primary-400" href="https://docs.example.com" rel="noopener noreferrer" target="_blank">
  "View docs"
 <p class="border-t border-gray-200 pt-3 text-xs text-gray-500 dark:border-dark-700 dark:text-dark-400" data-test="manual-footer">
  "Keep your key safe. Anyone who has it can spend your balance or plan."

### 复制与链接
按钮 copy-line-0-v1 -> "https://codex.hiyo.top/v1"
按钮 copy-line-0-base -> "https://codex.hiyo.top"
按钮 copy-key -> "sk-SECRET-1234567890abcdef"
按钮 Gemini CLI -> "export GOOGLE_GEMINI_BASE_URL='https://codex.hiyo.top'\\nexport GEMINI_API_KEY='sk-SECRET-1234567890abcdef'"
按钮 Gemini CLI -> "GOOGLE_GEMINI_BASE_URL='https://codex.hiyo.top'\\nGEMINI_API_KEY='sk-SECRET-1234567890abcdef'"
按钮 OpenCode -> "{\\n  \\"$schema\\": \\"https://opencode.ai/config.json\\",\\n  \\"provider\\": {\\n    \\"google\\": {\\n      \\"options\\": {\\n        \\"baseURL\\": \\"https://codex.hiyo.top/v1beta\\",\\n        \\"apiKey\\": \\"sk-SECRET-1234567890abcdef\\"\\n      }\\n    }\\n  }\\n}"
代码页签 = ["openai","curl","gemini"]
## manual-tab-openai
按钮 manual-code-openai-python -> "# pip install openai\\nfrom openai import OpenAI\\n\\nclient = OpenAI(\\n    base_url=\\"https://codex.hiyo.top/v1\\",\\n    api_key=\\"sk-SECRET-1234567890abcdef\\",\\n)\\n\\nresp = client.chat.completions.create(\\n    model=\\"gemini-3-pro\\",\\n    messages=[{\\"role\\": \\"user\\", \\"content\\": \\"Hello\\"}],\\n)\\nprint(resp.choices[0].message.content)"
## manual-tab-curl
按钮 manual-code-curl-bash -> "curl https://codex.hiyo.top/v1/chat/completions \\\\\\n  -H 'Authorization: Bearer sk-SECRET-1234567890abcdef' \\\\\\n  -H 'Content-Type: application/json' \\\\\\n  -d '{\\"model\\":\\"gemini-3-pro\\",\\"messages\\":[{\\"role\\":\\"user\\",\\"content\\":\\"Hello\\"}]}'"
按钮 manual-code-curl-windows -> "@'\\n{\\"model\\":\\"gemini-3-pro\\",\\"messages\\":[{\\"role\\":\\"user\\",\\"content\\":\\"Hello\\"}]}\\n'@ | curl.exe https://codex.hiyo.top/v1/chat/completions -H 'Authorization: Bearer sk-SECRET-1234567890abcdef' -H 'Content-Type: application/json' -d '@-'"
## manual-tab-gemini
按钮 manual-code-gemini-bash -> "export GOOGLE_GEMINI_BASE_URL='https://codex.hiyo.top'\\nexport GEMINI_API_KEY='sk-SECRET-1234567890abcdef'\\ngemini -m gemini-3-pro -p 'Hello'"
按钮 manual-code-gemini-windows -> "$env:GOOGLE_GEMINI_BASE_URL = 'https://codex.hiyo.top'\\n$env:GEMINI_API_KEY = 'sk-SECRET-1234567890abcdef'\\ngemini -m gemini-3-pro -p 'Hello'""
`;

