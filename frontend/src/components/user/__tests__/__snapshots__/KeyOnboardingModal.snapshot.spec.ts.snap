      <pre class="overflow-x-auto bg-gray-900 px-4 py-3 text-[13px] leading-relaxed text-gray-100 dark:bg-dark-950">
       "export ANTHROPIC_BASE_URL='https://codex.hiyo.top'\\nexport ANTHROPIC_AUTH_TOKEN='sk-SECRET-1234567890abcdef'"
     <div class="overflow-hidden rounded-lg border border-gray-200 bg-white dark:border-dark-700 dark:bg-dark-800">
      <div class="flex items-center justify-between gap-3 border-b border-gray-100 px-3 py-1.5 dark:border-dark-700">
       <span class="font-mono min-w-0 truncate text-xs text-gray-500 dark:text-dark-400">
