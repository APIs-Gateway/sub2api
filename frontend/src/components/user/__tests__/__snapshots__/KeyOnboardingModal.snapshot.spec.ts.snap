  打开 = ["_self"] {"host":"v1","path":"/import","params":{"resource":"provider","app":"codex","name":"Hiyo - Codex","homepage":"https://codex.hiyo.top","endpoint":"https://codex.hiyo.top","apiKey":"sk-SECRET-1234567890abcdef","configFormat":"json","enabled":"false","usageEnabled":"true","usageScript":"<688 字符 sha1:4d1d18499c78 开头:\\"KHsKICAgIHJlcXVlc3Q6IHsKICAgICAgdXJsOiAie3tiYXNlVXJsfX0iLnJl\\">","usageAutoInterval":"5"}}
