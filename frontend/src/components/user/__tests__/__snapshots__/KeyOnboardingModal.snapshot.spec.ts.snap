### 复制与链接
按钮 copy-line-0-v1 -> "https://codex.hiyo.top/v1"
按钮 copy-line-0-base -> "https://codex.hiyo.top"
按钮 copy-key -> "sk-SECRET-1234567890abcdef"
按钮 Claude Code -> "export ANTHROPIC_BASE_URL='https://codex.hiyo.top'\\nexport ANTHROPIC_AUTH_TOKEN='sk-SECRET-1234567890abcdef'"
按钮 Claude Code -> "{\\n  \\"env\\": {\\n    \\"ANTHROPIC_BASE_URL\\": \\"https://codex.hiyo.top\\",\\n    \\"ANTHROPIC_AUTH_TOKEN\\": \\"sk-SECRET-1234567890abcdef\\"\\n  }\\n}"
按钮 OpenCode -> "{\\n  \\"$schema\\": \\"https://opencode.ai/config.json\\",\\n  \\"provider\\": {\\n    \\"anthropic\\": {\\n      \\"options\\": {\\n        \\"baseURL\\": \\"https://codex.hiyo.top/v1\\",\\n        \\"apiKey\\": \\"sk-SECRET-1234567890abcdef\\"\\n      }\\n    }\\n  }\\n}"
代码页签 = ["openai","curl","claude"]
## manual-tab-openai
按钮 manual-code-openai-python -> "# pip install openai\\nfrom openai import OpenAI\\n\\nclient = OpenAI(\\n    base_url=\\"https://codex.hiyo.top/v1\\",\\n    api_key=\\"sk-SECRET-1234567890abcdef\\",\\n)\\n\\nresp = client.chat.completions.create(\\n    model=\\"claude-sonnet-5\\",\\n    messages=[{\\"role\\": \\"user\\", \\"content\\": \\"Hello\\"}],\\n)\\nprint(resp.choices[0].message.content)"
## manual-tab-curl
按钮 manual-code-curl-bash -> "curl https://codex.hiyo.top/v1/chat/completions \\\\\\n  -H 'Authorization: Bearer sk-SECRET-1234567890abcdef' \\\\\\n  -H 'Content-Type: application/json' \\\\\\n  -d '{\\"model\\":\\"claude-sonnet-5\\",\\"messages\\":[{\\"role\\":\\"user\\",\\"content\\":\\"Hello\\"}]}'"
按钮 manual-code-curl-windows -> "@'\\n{\\"model\\":\\"claude-sonnet-5\\",\\"messages\\":[{\\"role\\":\\"user\\",\\"content\\":\\"Hello\\"}]}\\n'@ | curl.exe https://codex.hiyo.top/v1/chat/completions -H 'Authorization: Bearer sk-SECRET-1234567890abcdef' -H 'Content-Type: application/json' -d '@-'"
## manual-tab-claude
按钮 manual-code-claude-bash -> "export ANTHROPIC_BASE_URL='https://codex.hiyo.top'\\nexport ANTHROPIC_AUTH_TOKEN='sk-SECRET-1234567890abcdef'\\nclaude -p 'Hello'"
按钮 manual-code-claude-windows -> "$env:ANTHROPIC_BASE_URL = 'https://codex.hiyo.top'\\n$env:ANTHROPIC_AUTH_TOKEN = 'sk-SECRET-1234567890abcdef'\\nclaude -p 'Hello'""
`;

exports[`KeyOnboardingModal 页签快照 > 'antigravity' > ai 页签 1`] = `
"### DOM
<div aria-labelledby="onboarding-N-tab-ai" class="onb-card space-y-4" data-test="panel-ai" id="onboarding-N-panel-ai" role="tabpanel">
 <p class="text-sm text-gray-600 dark:text-dark-400">
  "Pick the app you want to use and send this message to an AI assistant. It will walk you through the setup."
 <div aria-label="Client" class="flex flex-wrap gap-2" role="radiogroup">
  <button aria-checked="true" class="onb-chip onb-chip-active" data-test="ai-client-claude" role="radio" type="button">
   "Claude Code"
  <button aria-checked="false" class="onb-chip" data-test="ai-client-chat" role="radio" type="button">
   "Chat app"
  <button aria-checked="false" class="onb-chip" data-test="ai-client-code" role="radio" type="button">
   "Calling from code"
  <button aria-checked="false" class="onb-chip" data-test="ai-client-other" role="radio" type="button">
   "Other"
 <textarea class="input w-full resize-none text-sm leading-relaxed" data-test="ai-prompt" readonly="" rows="5" value="Please help me connect "Claude Code" to Hiyo. The endpoint is https://codex.hiyo.top/antigravity and the API format is Anthropic. It needs the environment variables ANTHROPIC_BASE_URL (the endpoint) and ANTHROPIC_AUTH_TOKEN (the key). They can also go in the env section of ~/.claude/settings.json. I will enter the key myself, so please do not ask me to send it to you. Docs: https://docs.example.com" :value="Please help me connect \\"Claude Code\\" to Hiyo. The endpoint is https://codex.hiyo.top/antigravity and the API format is Anthropic. It needs the environment variables ANTHROPIC_BASE_URL (the endpoint) and ANTHROPIC_AUTH_TOKEN (the key). They can also go in the env section of ~/.claude/settings.json. I will enter the key myself, so please do not ask me to send it to you. Docs: https://docs.example.com">
 <div class="flex flex-wrap gap-2">
  <button class="btn btn-primary btn-sm" data-test="ai-copy" type="button">
   "Copy"
  <button class="btn btn-secondary btn-sm" data-test="ai-copy-detail" type="button">
   "Copy detailed version"
  <button class="btn btn-secondary btn-sm" data-test="ai-open-chatgpt" type="button">
   "Open in ChatGPT"
  <button class="btn btn-secondary btn-sm" data-test="ai-open-claude" type="button">
   "Open in Claude"
 <p class="text-xs text-gray-500 dark:text-dark-400">
  "Your key is not in this message. Enter it yourself when you set things up."

### 复制与链接
