   "If it will not connect"
  <ul class="list-disc space-y-1.5 pl-5 text-sm text-gray-600 marker:text-gray-300 dark:text-dark-400 dark:marker:text-dark-600">
   <li>
    "Do not add extra slashes to the address. OpenAI-compatible clients need an address ending in /v1."
   <li>
    "Copy the whole key, with no spaces or line breaks around it."
   <li>
    "Restart the client after changing its config."
   <li>
    "Check that your network or proxy can reach the endpoint, and update the client if it is old."
 <a class="inline-flex text-sm font-medium text-primary-700 hover:underline dark:text-primary-400" href="https://docs.example.com" rel="noopener noreferrer" target="_blank">
  "View docs"
 <p class="border-t border-gray-200 pt-3 text-xs text-gray-500 dark:border-dark-700 dark:text-dark-400" data-test="manual-footer">
  "Keep your key safe. Anyone who has it can spend your balance or plan."

### 复制与链接
按钮 copy-line-0-base -> "https://codex.hiyo.top/antigravity"
按钮 copy-key -> "sk-SECRET-1234567890abcdef"
按钮 Claude Code -> "export ANTHROPIC_BASE_URL='https://codex.hiyo.top/antigravity'\\nexport ANTHROPIC_AUTH_TOKEN='sk-SECRET-1234567890abcdef'"
按钮 Claude Code -> "{\\n  \\"env\\": {\\n    \\"ANTHROPIC_BASE_URL\\": \\"https://codex.hiyo.top/antigravity\\",\\n    \\"ANTHROPIC_AUTH_TOKEN\\": \\"sk-SECRET-1234567890abcdef\\"\\n  }\\n}"
按钮 Gemini CLI -> "export GOOGLE_GEMINI_BASE_URL='https://codex.hiyo.top/antigravity'\\nexport GEMINI_API_KEY='sk-SECRET-1234567890abcdef'"
按钮 Gemini CLI -> "GOOGLE_GEMINI_BASE_URL='https://codex.hiyo.top/antigravity'\\nGEMINI_API_KEY='sk-SECRET-1234567890abcdef'"
代码页签 = ["claude","gemini"]
## manual-tab-claude
按钮 manual-code-claude-bash -> "export ANTHROPIC_BASE_URL='https://codex.hiyo.top/antigravity'\\nexport ANTHROPIC_AUTH_TOKEN='sk-SECRET-1234567890abcdef'\\nclaude -p 'Hello'"
按钮 manual-code-claude-windows -> "$env:ANTHROPIC_BASE_URL = 'https://codex.hiyo.top/antigravity'\\n$env:ANTHROPIC_AUTH_TOKEN = 'sk-SECRET-1234567890abcdef'\\nclaude -p 'Hello'"
## manual-tab-gemini
按钮 manual-code-gemini-bash -> "export GOOGLE_GEMINI_BASE_URL='https://codex.hiyo.top/antigravity'\\nexport GEMINI_API_KEY='sk-SECRET-1234567890abcdef'\\ngemini -m gemini-3-pro -p 'Hello'"
按钮 manual-code-gemini-windows -> "$env:GOOGLE_GEMINI_BASE_URL = 'https://codex.hiyo.top/antigravity'\\n$env:GEMINI_API_KEY = 'sk-SECRET-1234567890abcdef'\\ngemini -m gemini-3-pro -p 'Hello'""
`;

