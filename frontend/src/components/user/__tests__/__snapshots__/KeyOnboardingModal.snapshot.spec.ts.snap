   <div class="">
    <label class="input-label" for="onboarding-N-ccs-opusModel">
     "Opus model"
    <select aria-describedby="onboarding-N-ccs-models-hint" class="input" data-test="ccs-model-opus" disabled="" id="onboarding-N-ccs-opusModel" value="" :value="">
     <option value="">
      "Optional; leave blank to use the CC Switch default"
  <p class="input-hint mt-2 flex items-center gap-2" data-test="ccs-models-hint" id="onboarding-N-ccs-models-hint" role="status">
   <!--v-if-->
   "No models are available for this key. You can still import and leave the model fields blank."
 <p class="text-sm text-gray-600 dark:text-dark-400" data-test="ccs-switch-note">
