  打开 = ["https://chatgpt.com/?q=<133 字符 sha1:8fadca163620 开头:\\"请带我把「其他」接入 Hiyo。接入地址是 https://codex.hiyo.top，接口格式是 Anthropic\\"> [\\"_blank\\",\\"noopener,noreferrer\\"]","https://claude.ai/new?q=<133 字符 sha1:8fadca163620 开头:\\"请带我把「其他」接入 Hiyo。接入地址是 https://codex.hiyo.top，接口格式是 Anthropic\\"> [\\"_blank\\",\\"noopener,noreferrer\\"]"]
第一个客户端的详细版全文:
请带我一步步把「Claude Code」接入 Hiyo。

- 接入地址：https://codex.hiyo.top
- 接口格式：Anthropic
- 密钥：我会自己填写，请不要向我索要，也不要让我把密钥发在聊天里。
- 可用模型：claude-opus-5, claude-sonnet-5

需要设置环境变量 ANTHROPIC_BASE_URL（填接入地址）和 ANTHROPIC_AUTH_TOKEN（填密钥），也可以写进 ~/.claude/settings.json 的 env 里。

请先问我用的是什么系统，再告诉我要改哪个文件、怎么改。改之前提醒我备份原配置，配好后教我用一条简单的命令验证。
参考文档：https://docs.example.com"
`;

exports[`KeyOnboardingModal 页签快照 > 'anthropic 中文界面' > ccswitch 页签 1`] = `
"### DOM
<div aria-labelledby="onboarding-N-tab-ccswitch" class="onb-card space-y-4" data-test="panel-ccswitch" id="onboarding-N-panel-ccswitch" role="tabpanel">
 <div class="grid gap-4 sm:grid-cols-2">
  <!--v-if-->
  <div class="sm:col-span-2">
   <label class="input-label" for="ccs-name">
    "配置名称"
   <input class="input" data-test="ccs-name" id="ccs-name" placeholder="Hiyo - Claude" type="text" :value="">
  <div class="sm:col-span-2">
   <label class="input-label" for="ccs-model">
    "模型"
   <select class="input" data-test="ccs-model" id="ccs-model" :value="">
    <option value="">
     "默认"
    <option value="claude-opus-5">
     "claude-opus-5"
    <option value="claude-sonnet-5">
     "claude-sonnet-5"
 <div class="flex flex-wrap items-center gap-2">
  <button class="btn btn-primary" data-test="ccs-open" type="button">
   "打开 CC Switch"
  <button class="btn btn-secondary" data-test="ccs-copy-link" type="button">
   "复制导入链接"
 <p class="text-sm text-gray-600 dark:text-dark-400">
  "点了没反应？请先安装 CC Switch，再点一次。"
  <a class="font-medium text-primary-700 underline-offset-2 hover:underline dark:text-primary-400" href="https://github.com/farion1231/cc-switch/releases" rel="noopener noreferrer" target="_blank">
   "下载 CC Switch"

### 复制与链接
模型选项 = ["默认","claude-opus-5","claude-sonnet-5"]
(单一客户端): placeholder = Hiyo - Claude
  复制链接 = {"host":"v1","path":"/import","params":{"resource":"provider","app":"claude","name":"Hiyo - Claude","homepage":"https://codex.hiyo.top","endpoint":"https://codex.hiyo.top","apiKey":"sk-SECRET-1234567890abcdef","configFormat":"json","usageEnabled":"true","usageScript":"<692 字符 sha1:650401abcd2d 开头:\\"KHsKICAgIHJlcXVlc3Q6IHsKICAgICAgdXJsOiAie3tiYXNlVXJsfX0iLnJl\\">","usageAutoInterval":"30"}}
  打开 = ["_self"] {"host":"v1","path":"/import","params":{"resource":"provider","app":"claude","name":"Hiyo - Claude","homepage":"https://codex.hiyo.top","endpoint":"https://codex.hiyo.top","apiKey":"sk-SECRET-1234567890abcdef","configFormat":"json","usageEnabled":"true","usageScript":"<692 字符 sha1:650401abcd2d 开头:\\"KHsKICAgIHJlcXVlc3Q6IHsKICAgICAgdXJsOiAie3tiYXNlVXJsfX0iLnJl\\">","usageAutoInterval":"30"}}
  改名并选模型后 = {"host":"v1","path":"/import","params":{"resource":"provider","app":"claude","model":"claude-opus-5","name":"Mine","homepage":"https://codex.hiyo.top","endpoint":"https://codex.hiyo.top","apiKey":"sk-SECRET-1234567890abcdef","configFormat":"json","usageEnabled":"true","usageScript":"<692 字符 sha1:650401abcd2d 开头:\\"KHsKICAgIHJlcXVlc3Q6IHsKICAgICAgdXJsOiAie3tiYXNlVXJsfX0iLnJl\\">","usageAutoInterval":"30"}}"
`;

