     "Haiku model"
    <select aria-describedby="onboarding-N-ccs-models-hint" class="input" data-test="ccs-model-haiku" disabled="" id="onboarding-N-ccs-haikuModel" value="" :value="">
     <option value="">
      "Optional; leave blank to use the CC Switch default"
   <div class="">
    <label class="input-label" for="onboarding-N-ccs-sonnetModel">
     "Sonnet model"
    <select aria-describedby="onboarding-N-ccs-models-hint" class="input" data-test="ccs-model-sonnet" disabled="" id="onboarding-N-ccs-sonnetModel" value="" :value="">
     <option value="">
