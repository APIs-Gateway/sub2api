 <textarea class="input onb-sentence w-full resize-none text-sm leading-relaxed" data-test="ai-prompt" readonly="" rows="3" value="请按这份文档，帮我把 Claude Code 接入 Hiyo：http://localhost:3000/docs/claude-code.md" :value="请按这份文档，帮我把 Claude Code 接入 Hiyo：http://localhost:3000/docs/claude-code.md">
 <div class="flex flex-wrap gap-2">
  <button class="btn btn-primary btn-sm" data-test="ai-copy" type="button">
