     <span class="min-w-0 truncate">
      "macOS / Linux"
     <svg aria-hidden="true" class="h-5 w-5 onb-tile-icon" data-test="icon-copy" fill="none" stroke-width="1.5" stroke="currentColor" viewBox="0 0 24 24">
      <图标 sha1:be019e50ea17>
    <button aria-label="Copy command: Claude Code, Windows" class="onb-tile" data-copied="false" data-test="copy-claude-windows" type="button">
     <span class="min-w-0 truncate">
      "Windows"
     <svg aria-hidden="true" class="h-5 w-5 onb-tile-icon" data-test="icon-copy" fill="none" stroke-width="1.5" stroke="currentColor" viewBox="0 0 24 24">
      <图标 sha1:be019e50ea17>
  <!--v-if-->
  <details class="mt-3" data-test="script-claude">
   <summary class="inline-flex cursor-pointer select-none items-center gap-1 text-xs text-gray-500 hover:text-gray-900 dark:text-dark-400 dark:hover:text-white">
    "View script"
   <div class="mt-2 space-y-2">
    <div class="overflow-hidden rounded-lg border border-gray-200 dark:border-dark-700">
     <div class="border-b border-gray-100 px-3 py-1.5 text-xs text-gray-500 dark:border-dark-800 dark:text-dark-400">
      "macOS / Linux · ~/.claude/settings.json"
     <pre class="max-h-64 overflow-auto bg-gray-900 px-4 py-3 text-[12px] leading-relaxed text-gray-100 dark:bg-dark-950">
      <1887 字符 sha1:822ecc7207e3 开头:"bash <<'SUB2API_INSTALL_EOF'\\nset -e\\nexport SUB_ENDPOINT='htt">
    <div class="overflow-hidden rounded-lg border border-gray-200 dark:border-dark-700">
     <div class="border-b border-gray-100 px-3 py-1.5 text-xs text-gray-500 dark:border-dark-800 dark:text-dark-400">
      "Windows · %USERPROFILE%\\.claude\\settings.json"
     <pre class="max-h-64 overflow-auto bg-gray-900 px-4 py-3 text-[12px] leading-relaxed text-gray-100 dark:bg-dark-950">
      <2285 字符 sha1:fc77011cf1bd 开头:"& {\\n$ErrorActionPreference = 'Stop'\\n$ts = Get-Date -Format '">
 <section class="onb-card" data-test="client-gemini">
  <header class="flex items-center justify-between gap-3">
   <h4 class="font-serif text-lg text-gray-900 dark:text-white">
    "Gemini CLI"
   <!--v-if-->
  <div class="mt-4 space-y-2.5">
   <div class="grid gap-2.5 sm:grid-cols-2">
    <button aria-label="Copy command: Gemini CLI, macOS / Linux" class="onb-tile" data-copied="false" data-test="copy-gemini-unix" type="button">
     <span class="min-w-0 truncate">
      "macOS / Linux"
     <svg aria-hidden="true" class="h-5 w-5 onb-tile-icon" data-test="icon-copy" fill="none" stroke-width="1.5" stroke="currentColor" viewBox="0 0 24 24">
      <图标 sha1:be019e50ea17>
    <button aria-label="Copy command: Gemini CLI, Windows" class="onb-tile" data-copied="false" data-test="copy-gemini-windows" type="button">
     <span class="min-w-0 truncate">
      "Windows"
     <svg aria-hidden="true" class="h-5 w-5 onb-tile-icon" data-test="icon-copy" fill="none" stroke-width="1.5" stroke="currentColor" viewBox="0 0 24 24">
      <图标 sha1:be019e50ea17>
  <!--v-if-->
  <details class="mt-3" data-test="script-gemini">
   <summary class="inline-flex cursor-pointer select-none items-center gap-1 text-xs text-gray-500 hover:text-gray-900 dark:text-dark-400 dark:hover:text-white">
    "View script"
   <div class="mt-2 space-y-2">
    <div class="overflow-hidden rounded-lg border border-gray-200 dark:border-dark-700">
     <div class="border-b border-gray-100 px-3 py-1.5 text-xs text-gray-500 dark:border-dark-800 dark:text-dark-400">
      "macOS / Linux · ~/.gemini/.env"
     <pre class="max-h-64 overflow-auto bg-gray-900 px-4 py-3 text-[12px] leading-relaxed text-gray-100 dark:bg-dark-950">
      <1652 字符 sha1:da07b760d2e8 开头:"bash <<'SUB2API_INSTALL_EOF'\\nset -e\\nexport SUB_ENDPOINT='htt">
    <div class="overflow-hidden rounded-lg border border-gray-200 dark:border-dark-700">
     <div class="border-b border-gray-100 px-3 py-1.5 text-xs text-gray-500 dark:border-dark-800 dark:text-dark-400">
