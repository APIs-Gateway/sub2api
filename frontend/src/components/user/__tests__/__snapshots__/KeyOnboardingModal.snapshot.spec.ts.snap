按钮 Claude Code -> "{\\n  \\"env\\": {\\n    \\"ANTHROPIC_BASE_URL\\": \\"https://codex.hiyo.top/antigravity\\",\\n    \\"ANTHROPIC_AUTH_TOKEN\\": \\"sk-SECRET-1234567890abcdef\\"\\n  }\\n}"
按钮 Gemini CLI -> "export GOOGLE_GEMINI_BASE_URL='https://codex.hiyo.top/antigravity'\\nexport GEMINI_API_KEY='sk-SECRET-1234567890abcdef'"
按钮 Gemini CLI -> "GOOGLE_GEMINI_BASE_URL='https://codex.hiyo.top/antigravity'\\nGEMINI_API_KEY='sk-SECRET-1234567890abcdef'"
