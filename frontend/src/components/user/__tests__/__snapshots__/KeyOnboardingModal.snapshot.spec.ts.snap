### 复制与链接
按钮 copy-line-0-v1 -> "https://api.example.com/v1"
按钮 copy-line-0-base -> "https://api.example.com"
按钮 copy-line-1-v1 -> "https://cdn.example.com/v1"
按钮 copy-line-1-base -> "https://cdn.example.com"
按钮 copy-key -> "sk-SECRET-1234567890abcdef"
按钮 Codex CLI -> "model_provider = \\"hiyo\\"\\nmodel = \\"gpt-5.6-sol\\"\\n\\n[model_providers.hiyo]\\nname = \\"Hiyo\\"\\nbase_url = \\"https://cdn.example.com/v1\\"\\nwire_api = \\"responses\\"\\nrequires_openai_auth = false\\nexperimental_bearer_token = \\"sk-SECRET-1234567890abcdef\\""
按钮 Claude Code -> "export ANTHROPIC_BASE_URL='https://cdn.example.com'\\nexport ANTHROPIC_AUTH_TOKEN='sk-SECRET-1234567890abcdef'"
按钮 Claude Code -> "{\\n  \\"env\\": {\\n    \\"ANTHROPIC_BASE_URL\\": \\"https://cdn.example.com\\",\\n    \\"ANTHROPIC_AUTH_TOKEN\\": \\"sk-SECRET-1234567890abcdef\\"\\n  }\\n}"
按钮 OpenCode -> "{\\n  \\"$schema\\": \\"https://opencode.ai/config.json\\",\\n  \\"provider\\": {\\n    \\"openai\\": {\\n      \\"options\\": {\\n        \\"baseURL\\": \\"https://cdn.example.com/v1\\",\\n        \\"apiKey\\": \\"sk-SECRET-1234567890abcdef\\"\\n      }\\n    }\\n  }\\n}"
代码页签 = ["openai","curl","codex","claude"]
## manual-tab-openai
按钮 manual-code-openai-python -> "# pip install openai\\nfrom openai import OpenAI\\n\\nclient = OpenAI(\\n    base_url=\\"https://cdn.example.com/v1\\",\\n    api_key=\\"sk-SECRET-1234567890abcdef\\",\\n)\\n\\nresp = client.chat.completions.create(\\n    model=\\"gpt-5.6-sol\\",\\n    messages=[{\\"role\\": \\"user\\", \\"content\\": \\"Hello\\"}],\\n)\\nprint(resp.choices[0].message.content)"
## manual-tab-curl
按钮 manual-code-curl-bash -> "curl https://cdn.example.com/v1/chat/completions \\\\\\n  -H 'Authorization: Bearer sk-SECRET-1234567890abcdef' \\\\\\n  -H 'Content-Type: application/json' \\\\\\n  -d '{\\"model\\":\\"gpt-5.6-sol\\",\\"messages\\":[{\\"role\\":\\"user\\",\\"content\\":\\"Hello\\"}]}'"
按钮 manual-code-curl-windows -> "@'\\n{\\"model\\":\\"gpt-5.6-sol\\",\\"messages\\":[{\\"role\\":\\"user\\",\\"content\\":\\"Hello\\"}]}\\n'@ | curl.exe https://cdn.example.com/v1/chat/completions -H 'Authorization: Bearer sk-SECRET-1234567890abcdef' -H 'Content-Type: application/json' -d '@-'"
## manual-tab-codex
按钮 manual-code-codex-bash -> "export OPENAI_API_KEY='sk-SECRET-1234567890abcdef'\\ncodex exec --skip-git-repo-check -m gpt-5.6-sol \\\\\\n  -c model_provider=hiyo \\\\\\n  -c model_providers.hiyo.name=Hiyo \\\\\\n  -c model_providers.hiyo.base_url=https://cdn.example.com/v1 \\\\\\n  -c model_providers.hiyo.env_key=OPENAI_API_KEY \\\\\\n  -c model_providers.hiyo.wire_api=responses \\\\\\n  'Hello'"
按钮 manual-code-codex-windows -> "$env:OPENAI_API_KEY = 'sk-SECRET-1234567890abcdef'\\ncodex exec --skip-git-repo-check -m gpt-5.6-sol -c model_provider=hiyo -c model_providers.hiyo.name=Hiyo -c model_providers.hiyo.base_url=https://cdn.example.com/v1 -c model_providers.hiyo.env_key=OPENAI_API_KEY -c model_providers.hiyo.wire_api=responses 'Hello'"
## manual-tab-claude
按钮 manual-code-claude-bash -> "export ANTHROPIC_BASE_URL='https://cdn.example.com'\\nexport ANTHROPIC_AUTH_TOKEN='sk-SECRET-1234567890abcdef'\\nclaude -p 'Hello'"
按钮 manual-code-claude-windows -> "$env:ANTHROPIC_BASE_URL = 'https://cdn.example.com'\\n$env:ANTHROPIC_AUTH_TOKEN = 'sk-SECRET-1234567890abcdef'\\nclaude -p 'Hello'""
`;

