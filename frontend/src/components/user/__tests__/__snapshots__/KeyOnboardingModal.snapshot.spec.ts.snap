### 复制与链接
按钮 copy-line-0-v1 -> "https://codex.hiyo.top/v1"
按钮 copy-line-0-base -> "https://codex.hiyo.top"
按钮 copy-key -> "sk-SECRET-1234567890abcdef"
按钮 Gemini CLI -> "export GOOGLE_GEMINI_BASE_URL='https://codex.hiyo.top'\\nexport GEMINI_API_KEY='sk-SECRET-1234567890abcdef'"
按钮 Gemini CLI -> "GOOGLE_GEMINI_BASE_URL='https://codex.hiyo.top'\\nGEMINI_API_KEY='sk-SECRET-1234567890abcdef'"
按钮 OpenCode -> "{\\n  \\"$schema\\": \\"https://opencode.ai/config.json\\",\\n  \\"provider\\": {\\n    \\"google\\": {\\n      \\"options\\": {\\n        \\"baseURL\\": \\"https://codex.hiyo.top/v1beta\\",\\n        \\"apiKey\\": \\"sk-SECRET-1234567890abcdef\\"\\n      }\\n    }\\n  }\\n}"
代码页签 = ["openai","curl","gemini"]
## manual-tab-openai
按钮 manual-code-openai-python -> "# pip install openai\\nfrom openai import OpenAI\\n\\nclient = OpenAI(\\n    base_url=\\"https://codex.hiyo.top/v1\\",\\n    api_key=\\"sk-SECRET-1234567890abcdef\\",\\n)\\n\\nresp = client.chat.completions.create(\\n    model=\\"gemini-3-pro\\",\\n    messages=[{\\"role\\": \\"user\\", \\"content\\": \\"Hello\\"}],\\n)\\nprint(resp.choices[0].message.content)"
## manual-tab-curl
按钮 manual-code-curl-bash -> "curl https://codex.hiyo.top/v1/chat/completions \\\\\\n  -H 'Authorization: Bearer sk-SECRET-1234567890abcdef' \\\\\\n  -H 'Content-Type: application/json' \\\\\\n  -d '{\\"model\\":\\"gemini-3-pro\\",\\"messages\\":[{\\"role\\":\\"user\\",\\"content\\":\\"Hello\\"}]}'"
按钮 manual-code-curl-windows -> "@'\\n{\\"model\\":\\"gemini-3-pro\\",\\"messages\\":[{\\"role\\":\\"user\\",\\"content\\":\\"Hello\\"}]}\\n'@ | curl.exe https://codex.hiyo.top/v1/chat/completions -H 'Authorization: Bearer sk-SECRET-1234567890abcdef' -H 'Content-Type: application/json' -d '@-'"
## manual-tab-gemini
按钮 manual-code-gemini-bash -> "export GOOGLE_GEMINI_BASE_URL='https://codex.hiyo.top'\\nexport GEMINI_API_KEY='sk-SECRET-1234567890abcdef'\\ngemini -m gemini-3-pro -p 'Hello'"
按钮 manual-code-gemini-windows -> "$env:GOOGLE_GEMINI_BASE_URL = 'https://codex.hiyo.top'\\n$env:GEMINI_API_KEY = 'sk-SECRET-1234567890abcdef'\\ngemini -m gemini-3-pro -p 'Hello'""
`;

exports[`KeyOnboardingModal 页签快照 > 'openai 备用线路 + 调度' > ai 页签 1`] = `
"### DOM
<div data-v-app="">
 <div width="wide">
  <p aria-live="polite" class="sr-only" data-test="copy-status" role="status">
  <div class="space-y-5">
   <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1" data-test="subtitle">
    <span class="text-base text-gray-600 dark:text-dark-300">
     "Connect "my-key" to your client"
    <code class="font-mono text-xs tabular-nums text-gray-500 dark:text-dark-400">
     "sk-SEC…cdef"
   <div class="onb-lines" data-test="endpoints">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
     <span class="onb-lines-label" id="onboarding-N-endpoints-label">
      "API Endpoints"
     <div aria-describedby="onboarding-N-endpoints-hint" aria-labelledby="onboarding-N-endpoints-label" class="flex flex-wrap gap-2" role="radiogroup">
      <label class="onb-chip onb-line">
       <input class="sr-only" data-test="endpoint-default" name="onboarding-N-endpoint" type="radio" value="default" :checked=false>
       "Default"
      <label class="onb-chip onb-line onb-chip-active">
       <input class="sr-only" data-test="endpoint-https://cdn.example.com" name="onboarding-N-endpoint" type="radio" value="https://cdn.example.com" :checked=true>
       "CDN 加速"
    <p class="onb-lines-detail" data-test="endpoint-detail">
     <span class="text-gray-600 dark:text-dark-300">
      "国内访问更快"
     <code class="font-mono tabular-nums">
      "https://cdn.example.com"
    <p class="onb-lines-hint" id="onboarding-N-endpoints-hint">
     "If access is slow, switch to another API endpoint. Your API key works with all of them."
   <div class="flex flex-wrap gap-1 border-b border-gray-200 pb-3 dark:border-dark-700" role="tablist">
    <button aria-controls="onboarding-N-panel-install" aria-selected="false" class="onb-tab" data-test="tab-install" id="onboarding-N-tab-install" role="tab" tabindex="-1" type="button">
     <svg aria-hidden="true" class="h-4 w-4" fill="none" stroke-width="1.5" stroke="currentColor" viewBox="0 0 24 24">
      <图标 sha1:bdb27ca125e7>
     <span>
      "Install"
    <button aria-controls="onboarding-N-panel-ai" aria-selected="true" class="onb-tab onb-tab-active" data-test="tab-ai" id="onboarding-N-tab-ai" role="tab" tabindex="0" type="button">
     <svg aria-hidden="true" class="h-4 w-4" fill="none" stroke-width="1.5" stroke="currentColor" viewBox="0 0 24 24">
      <图标 sha1:8867038ce987>
     <span>
      "Ask an AI"
    <button aria-controls="onboarding-N-panel-ccswitch" aria-selected="false" class="onb-tab" data-test="tab-ccswitch" id="onboarding-N-tab-ccswitch" role="tab" tabindex="-1" type="button">
     <svg aria-hidden="true" class="h-4 w-4" fill="none" stroke-width="1.5" stroke="currentColor" viewBox="0 0 24 24">
      <图标 sha1:a38762ad2594>
     <span>
      "CC Switch"
    <button aria-controls="onboarding-N-panel-manual" aria-selected="false" class="onb-tab" data-test="tab-manual" id="onboarding-N-tab-manual" role="tab" tabindex="-1" type="button">
     <svg aria-hidden="true" class="h-4 w-4" fill="none" stroke-width="1.5" stroke="currentColor" viewBox="0 0 24 24">
      <图标 sha1:e3e3e70392f1>
     <span>
      "Manual"
   <div aria-labelledby="onboarding-N-tab-ai" class="onb-card space-y-4" data-test="panel-ai" id="onboarding-N-panel-ai" role="tabpanel">
    <p class="text-sm text-gray-600 dark:text-dark-400">
     "Pick the app you want to use and send this message to an AI assistant. It will walk you through the setup."
    <div aria-label="Client" class="flex flex-wrap gap-2" role="radiogroup">
     <button aria-checked="true" class="onb-chip onb-chip-active" data-test="ai-client-codex" role="radio" type="button">
      "Codex"
     <button aria-checked="false" class="onb-chip" data-test="ai-client-claude" role="radio" type="button">
      "Claude Code"
     <button aria-checked="false" class="onb-chip" data-test="ai-client-cursor" role="radio" type="button">
      "Cursor"
     <button aria-checked="false" class="onb-chip" data-test="ai-client-chat" role="radio" type="button">
      "Chat app"
     <button aria-checked="false" class="onb-chip" data-test="ai-client-code" role="radio" type="button">
      "Calling from code"
     <button aria-checked="false" class="onb-chip" data-test="ai-client-other" role="radio" type="button">
      "Other"
    <textarea class="input w-full resize-none text-sm leading-relaxed" data-test="ai-prompt" readonly="" rows="5" value="Please help me connect "Codex" to Hiyo. The endpoint is https://cdn.example.com/v1 and the API format is OpenAI. It needs a custom model provider in ~/.codex/config.toml, with base_url set to the endpoint, wire_api set to "responses", and the key filled in. I will enter the key myself, so please do not ask me to send it to you." :value="Please help me connect \\"Codex\\" to Hiyo. The endpoint is https://cdn.example.com/v1 and the API format is OpenAI. It needs a custom model provider in ~/.codex/config.toml, with base_url set to the endpoint, wire_api set to \\"responses\\", and the key filled in. I will enter the key myself, so please do not ask me to send it to you.">
    <div class="flex flex-wrap gap-2">
     <button class="btn btn-primary btn-sm" data-test="ai-copy" type="button">
      "Copy"
     <button class="btn btn-secondary btn-sm" data-test="ai-copy-detail" type="button">
      "Copy detailed version"
     <button class="btn btn-secondary btn-sm" data-test="ai-open-chatgpt" type="button">
      "Open in ChatGPT"
     <button class="btn btn-secondary btn-sm" data-test="ai-open-claude" type="button">
      "Open in Claude"
    <p class="text-xs text-gray-500 dark:text-dark-400">
     "Your key is not in this message. Enter it yourself when you set things up."

